# cp .env.example .env   (make up does this). Dev-only defaults; rotate everything before exposing the stack.
VERSION=0.1.0
GCP_PROJECT=ramen-local
RAMEN_ADMIN_EMAIL=admin@ramen.local
RAMEN_ADMIN_PASSWORD=changeme-ramen
# Fernet key = 32 url-safe base64 bytes. Regenerate: python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
RAMEN_FERNET_KEY=0VnINh_5EgyBnkUEf44BuR7CTKLrb97GSTjdjTbbkhY=
# Worker MCP bearer keys (comma list) and admin key used by the console to trigger /admin/reload.
RAMEN_MCP_KEYS=local-mcp-key
RAMEN_ADMIN_KEY=local-admin-key
RAMEN_ALLOWED_CIDRS=0.0.0.0/0,::/0
RAMEN_VERBOSE=0
