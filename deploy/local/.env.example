# `make env` (run by `make up`) writes .env from this file and GENERATES every secret below; nothing static ships.
# Rotate before exposing the stack: delete the value and run `make env` again, or edit .env by hand.
VERSION=0.8.0
GCP_PROJECT=ramen-local
RAMEN_ADMIN_EMAIL=admin@ramen.local
RAMEN_ADMIN_PASSWORD=
# Fernet key = 32 url-safe base64 bytes, generated by make env (python3 -c "import base64,os;print(base64.urlsafe_b64encode(os.urandom(32)).decode())")
RAMEN_FERNET_KEY=
# Worker MCP bearer keys (comma list) and admin key used by the console to trigger /admin/reload.
RAMEN_MCP_KEYS=
RAMEN_ADMIN_KEY=
RAMEN_ALLOWED_CIDRS=0.0.0.0/0,::/0
RAMEN_VERBOSE=0
# Auth (CONTRACTS §9). Mail: file:///mail writes .eml files to deploy/local/.mail; e.g. RAMEN_SMTP_HOST=smtp.example.com RAMEN_SMTP_PORT=587
# RAMEN_SMTP_USER=... RAMEN_SMTP_PASSWORD=... RAMEN_SMTP_TLS=1 (starttls) | ssl | 0. Links in mails use RAMEN_PUBLIC_URL.
RAMEN_PUBLIC_URL=https://localhost:8443
RAMEN_SMTP_HOST=file:///mail
RAMEN_SMTP_FROM=ramen@localhost
RAMEN_AUTH_MAGIC_LINK=0
# Break-glass: with auth.password_login off, the bootstrap admin may still use the password when this is 1.
RAMEN_ADMIN_FORCE_PASSWORD=0
# OAuth/OIDC provider (button on the login page): RAMEN_OAUTH_<NAME>_ISSUER, _CLIENT_ID, _CLIENT_SECRET, optional _SCOPES,
# RAMEN_AUTH_OAUTH_<NAME>_ROLE_CLAIM=groups RAMEN_AUTH_OAUTH_<NAME>_ROLE_MAP="admins=super_admin;devs=group_admin:demo"

# Shared by the worker and the console (Streamable HTTP sessions and OAuth tokens, CONTRACTS §16); rotate before exposing
RAMEN_SESSION_SECRET=
# Browser origins allowed to call /mcp; empty refuses every browser (§16.1)
RAMEN_ALLOWED_ORIGINS=
